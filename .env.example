# The server's LAN address. You'll open https://<this>:8443 on your phone/PC.
VL_HOST=192.168.1.50

# Sign-in password. Strongly recommended; required before the Cloudflare tunnel works.
# Wrap it in single quotes if it contains a $ sign.
VL_PASSWORD=change-me

# Optional. These are the defaults.
# VL_HTTPS_PORT=8443   # the address you open: https://VL_HOST:8443
# VL_TUNNEL_PORT=18095 # plain HTTP for cloudflared: http://VL_HOST:18095
# MAX_SONG_MINUTES=12
# CREPE_MODEL=tiny
# DEMUCS_MODEL=htdemucs
# PROCESS_THREADS=5
# YTDLP_AUTO_UPDATE=1
