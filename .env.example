# The server's LAN address. You'll open https://<this>:8443 on your phone/PC.
VL_HOST=192.168.1.50

# Longest song accepted, in minutes.
MAX_SONG_MINUTES=12

# Pitch model: tiny (fast, good) or full (more accurate on tricky vocals, ~15x slower on CPU).
CREPE_MODEL=tiny

# Separation model: htdemucs (default), htdemucs_ft (a bit cleaner, ~4x slower), mdx_extra
DEMUCS_MODEL=htdemucs

# CPU threads for processing. The i5-9500T has 6; leave one or two for everything else.
PROCESS_THREADS=5

# Update yt-dlp each time the container starts (1 = yes).
YTDLP_AUTO_UPDATE=1
